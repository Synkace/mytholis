rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ======================================================================
       AUTHORIZATION MODEL
       ----------------------------------------------------------------------
       Admin rights come from ONE place: the `admin: true` custom claim,
       which can only be set by the Admin SDK (never by a client).

       Transitional bridge (remove once the founder's claim is set):
       a SINGLE verified email address. It is safe only because of the
       `email_verified == true` requirement - an attacker cannot register
       and verify an address they do not control. Do not add more addresses
       here; use the admin claim instead (see functions/handlers/admin.js
       action SET_ADMIN_CLAIM).
       ====================================================================== */
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email == 'gunhegarr@gmail.com'
        )
      );
    }

    // Only a verified address may be used to match order ownership.
    function verifiedEmail() {
      return request.auth.token.email_verified == true
        ? request.auth.token.email
        : null;
    }

    /* ---- Fields a collector may write on their own document. ------------
       Everything else is server-only. In particular: role, isAdmin,
       loyalty, points, tier, manual_tier_override, active_reward_codes,
       createdAt, referralCode.
       NOTE: `profile` is presentation data only. No authorization decision
       anywhere may read profile.role / profile.isAdmin.
       -------------------------------------------------------------------- */
    function selfWritableFields() {
      return [
        'name', 'displayName', 'photoURL',
        'phone', 'phoneNumber',
        'address', 'pincode', 'city', 'state',
        'emailCanonical', 'phoneCanonical', 'addressKey', 'emails', 'linkedUids',
        'profile',
        'referralCode', 'referredBy', 'referralNoticesSeenAt',
        'updatedAt', 'lastLoginAt',
        'signup_bonus_popup_seen', 'isMergedDuplicate', 'activeDocUid'
      ];
    }

    // 1. Collector profiles
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // First write: safe fields only. Loyalty is created by the server.
      allow create: if signedIn() && request.auth.uid == userId &&
                       request.resource.data.keys().hasOnly(selfWritableFields());

      // Any later self-write may only touch safe fields. Any attempt to
      // change role / isAdmin / loyalty / points makes affectedKeys()
      // contain a forbidden key and the whole write is rejected.
      allow update: if signedIn() && request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfWritableFields());

      allow delete: if isAdmin();

      match /{document=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // 2. Orders - creation and pricing are SERVER ONLY.
    // Cloud Functions use the Admin SDK and bypass these rules. An admin may
    // still update fulfilment fields (status, courier, AWB) from the dashboard;
    // that is gated on the admin claim, which a client cannot forge.
    match /orders/{orderId} {
      allow create: if false;
      allow update, delete: if isAdmin();

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        (
          verifiedEmail() != null &&
          resource.data.userEmail == verifiedEmail()
        )
      );
    }

    // 3. Global settings
    match /settings/public_config {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // 4. Voucher vault - server only.
    // `allow read: if true` previously made the whole collection listable,
    // which exposed every unredeemed code.
    match /reward_codes/{code} {
      allow read, write: if isAdmin();
    }
    match /vouchers/{voucherId} {
      allow read, write: if isAdmin();
    }

    // 5. Storefront catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Editorial / Gazette posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Diagnostics
    match /_diagnostics/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
