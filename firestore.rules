rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*gunhegarr.*') ||
          request.auth.token.email in ['gunhegarr@gmail.com', 'admin@mytholis.com', 'alexander@mytholis.com', 'founder@mytholis.com']
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true))
      );
    }
    
    // 1. Patrons can read & write their own profile and loyalty records; Admins have sovereign access
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Nested user orders or history
      match /{document=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }

    // 2. Orders collection: Any patron/guest can submit an order. Read/Update for authenticated owners or admin.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 3. Settings & Inventory Overrides: Publicly readable so patrons see real-time drops.
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Vault Reward Codes: Readable by patrons during cart concession validation.
    match /reward_codes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Editorial / Gazette Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Diagnostics Ping:
    match /_diagnostics/{doc} {
      allow read, write: if true;
    }
  }
}
