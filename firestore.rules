rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['gunhegarr@gmail.com', 'admin@mytholis.com', 'alexander@mytholis.com', 'founder@mytholis.com']
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true))
      );
    }
    
    // 1. Collectors can read & update their own profile (cannot escalate role or tamper with isAdmin); Admins have sovereign read/write
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if (request.auth != null && request.auth.uid == userId &&
                      !('role' in request.resource.data) &&
                      !('isAdmin' in request.resource.data)) || isAdmin();
      allow update: if (request.auth != null && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) ||
                       isAdmin();
      allow delete: if isAdmin();
      
      // Nested user orders or history
      match /{document=**} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // 2. Orders collection: Created by checkout. Only order owner or admin can read; only admin can update/delete.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      allow update, delete: if isAdmin();
    }

    // 3. Settings & Inventory Overrides: Publicly readable; writable ONLY by verified admin.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Vault Reward Codes: Publicly readable; writable ONLY by verified admin or server.
    match /reward_codes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Editorial / Gazette Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Diagnostics Ping:
    match /_diagnostics/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
