# ==============================================================================
# MYTHOLIS SOVEREIGN CLOUD FUNCTIONS - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Sanctum Command / Founder Access
ADMIN_EMAIL=founder@mytholis.com

# 2. Project Identifier (Project ID is also automatically set by Google Cloud as GCLOUD_PROJECT)
MYTHOLIS_PROJECT_ID=mytholis-1

# 3. Fastrr / Shiprocket Checkout Gateway
FASTRR_API_KEY=
FASTRR_SECRET_KEY=
FASTRR_CHECKOUT_URL=https://checkout-api.shiprocket.com/api/v1/access-token/checkout

# 4. PayU Hosted Payment Gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Set to 'live' for production or 'test' for staging/sandbox
PAYU_ENV=live

# 5. Shiprocket Logistics Integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
