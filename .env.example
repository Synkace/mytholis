# ==============================================================================
# Mytholis Haute Parfumerie - Environment Configuration
# Copy to `.env` (client) and `functions/.env` (server). Both are gitignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# CLIENT (Vite) - everything here is PUBLIC. Never put a secret below this line.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mytholis.com
VITE_FIREBASE_PROJECT_ID=mytholis-1
VITE_FIREBASE_STORAGE_BUCKET=mytholis-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local Vite dev API proxy (defaults to http://127.0.0.1:5001)
VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Publishable Razorpay key id only. The key SECRET never goes here.
VITE_RAZORPAY_KEY_ID=

# Meta Pixel id. Leave empty until a consent gate exists.
VITE_META_PIXEL_ID=

# VITE_ADMIN_EMAIL was removed: it baked the founder's address into the public
# bundle and only gated cosmetic UI. Admin state now comes from the `admin`
# custom claim, mirrored onto the user document by the server.

# ------------------------------------------------------------------------------
# SERVER (Cloud Functions) - functions/.env. NEVER commit this file.
# ------------------------------------------------------------------------------
PORT=5001

# Razorpay live credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this in the Razorpay dashboard when you create the webhook, then paste it here.
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated. Exact match only, and only honoured for a VERIFIED address.
# This is a bootstrap bridge; prefer the `admin: true` custom claim.
ADMIN_EMAIL=gunhegarr@gmail.com

# Shared secret for the logistics/courier status webhook
DISPATCH_WEBHOOK_SECRET=

# Project id override (usually inferred from GCLOUD_PROJECT on Firebase)
MYTHOLIS_PROJECT_ID=mytholis-1
# Transactional email (Resend). Leave blank to disable; orders still complete.
RESEND_API_KEY=
MAIL_FROM=Mytholis <orders@mytholis.com>
MAIL_REPLY_TO=concierge@mytholis.com