# ==============================================================================
# MYTHOLIS LUXURY PERFUME - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Sanctum Command Founder Access (Replace with your Google login email)
ADMIN_EMAIL=founder@mytholis.com
VITE_ADMIN_EMAIL=founder@mytholis.com

# 2. Razorpay Live Payment Gateway
# Obtain from Razorpay Dashboard -> Settings -> API Keys (rzp_test_... for test, rzp_live_... for production)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# 3. Client-Side Firebase Configuration (Vite Web App)
VITE_FIREBASE_API_KEY=AIzaSyBc2aJMywhHkOTLLZKj8jFcYivZ3tJE-Qg
# Set to custom domain (mytholis.com) with Vercel rewrite to hide firebaseapp.com during Google Sign-In:
VITE_FIREBASE_AUTH_DOMAIN=mytholis.com
VITE_FIREBASE_PROJECT_ID=mytholis-1
VITE_FIREBASE_STORAGE_BUCKET=mytholis-1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=227633160778
VITE_FIREBASE_APP_ID=1:227633160778:web:6511ffcd68584df1adfcb3
VITE_FIREBASE_MEASUREMENT_ID=G-RN50TZNZH3

# 4. Server-Side Firebase Admin SDK (Vercel Serverless /api)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID=mytholis-1
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mytholis-1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Alternatively, paste full minified service account JSON:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mytholis-1",...}
